# SpendGuard backend environment variables
# Copy this file to .env and fill in real values.

# Server
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai
USE_LLM_EXTRACTION=true

DAYTONA_API_KEY=
DAYTONA_TARGET=
USE_DAYTONA=true
USE_LOCAL_EXECUTOR_FALLBACK=true

USE_STRIPE_TEST_MODE=false
STRIPE_SECRET_KEY=
MOCK_PAYMENT_SECRET=demo_mock_secret

# 1Password runtime credential broker (the rubric integration).
# OP_SERVICE_ACCOUNT_TOKEN is the BROKER identity; it mints the payment
# credential just-in-time. Leave empty to use the mock fallback.
OP_SERVICE_ACCOUNT_TOKEN=
OP_PAYMENT_CREDENTIAL_REFERENCE=op://SpendGuard/Stripe/secret_key

SPENDGUARD_POLICY_PATH=backend/config/policy.json
SPENDGUARD_SEED_REQUESTS_PATH=backend/data/seed_requests.json
AUDIT_LOG_PATH=backend/data/audit_log.json
