# 1Password runtime secret references.
#
# `op run` reads this file and resolves each `op://vault/item/field` reference
# into a real environment variable FOR THE CHILD PROCESS ONLY, at runtime.
# The payment worker reads STRIPE_SECRET_KEY from the environment when it runs;
# the model, the trace, the frontend, and the audit log never see it.
#
# Usage:
#   op signin
#   op run --env-file=op.env -- ./.venv/bin/uvicorn app.main:app --port 8000
#
# Replace the vault/item/field below with your real 1Password references.

STRIPE_SECRET_KEY=op://SpendGuard/Stripe/secret_key
USE_STRIPE_TEST_MODE=true

# Optional: also source other credentials from 1Password.
# DAYTONA_API_KEY=op://SpendGuard/Daytona/api_key
